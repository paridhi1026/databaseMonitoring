# CERN DBS / dbs2go API Base URL Configuration
# Set VITE_API_BASE_URL to point to a CERN DBS reader instance or local dbs2go API service.
# If left empty, the application will display a clear "No data source connected" state.
VITE_API_BASE_URL=https://cmsweb.cern.ch/dbs/prod/global/DBSReader
VITE_DBS_INSTANCE=global
